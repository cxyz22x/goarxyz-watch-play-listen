{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goarxyz-wisp",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "WISP",
        "class_name": "WispServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-wisp",
      "new_sqlite_classes": ["WispServer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
